---
import '../styles/blog.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadBlog } from '../lib.js';

const { title, description, path, image, imageAlt, type = 'website', ld, noindex = false, slug, progress = false, current = '', mdAlt } = Astro.props;
const blog = loadBlog();
const url = blog.abs(path);
const img = blog.abs(image.src);
const adsense = blog.cfg.ads.adsense.client;
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}>
<link rel="alternate" type="application/rss+xml" title={blog.cfg.title} href="/blog/feed.xml">
<link rel="alternate" type="application/feed+json" title={blog.cfg.title} href="/blog/feed.json">
{mdAlt && <link rel="alternate" type="text/markdown" title="Markdown sürümü" href={mdAlt}>}
<link rel="icon" type="image/png" href="/assets/img/educator-fabicon-300x300.png">
<meta name="theme-color" content="#FBFAFD">
<link rel="preload" href="/blog/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/blog/fonts/literata-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<meta property="og:type" content={type}>
<meta property="og:site_name" content="BÖTE">
<meta property="og:locale" content="tr_TR">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={img}>
<meta property="og:image:width" content={String(image.width)}>
<meta property="og:image:height" content={String(image.height)}>
<meta property="og:image:alt" content={imageAlt || title}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={img}>
<slot name="head" />
<script is:inline>(function(){var d=document.documentElement;try{if(localStorage.getItem('bote-theme')==='dark')d.setAttribute('data-theme','dark');if(localStorage.getItem('bote-cites')==='on')d.setAttribute('data-cites','on');if(localStorage.getItem('bote-backrefs')==='on')d.setAttribute('data-backrefs','on')}catch(e){}})();</script>
{adsense && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`} crossorigin="anonymous"></script>}
<script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
</head>
<body data-slug={slug}>
<a class="skip" href="#icerik">İçeriğe geç</a>
<Header progress={progress} current={current} />
<main id="icerik">
<slot />
</main>
<Footer />
</body>
</html>
