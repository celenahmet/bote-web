---
// "AI ile Özetle" (Ahmet 29.10.2026; Veterito, UniConnectly ve OtoSenior'da aynısı).
// <details> BİLEREK: JS olmadan da açılıp kapanıyor, içerik JS'siz okunabilir
// kuralına uyuyor. Betik yalnız dışarı tıklayınca, seçimde ve Esc ile kapatıyor.
// Parıltı simgesi yok; "yapay zekâya sor" anlamını bot simgesi taşıyor.
import Icon from './Icon.astro';
import { markaSvg } from '../markaSimgeleri.js';
import { ozetIstemi, yzBaglantilari } from '../paylasim.js';
const { url, title } = Astro.props;
---
<details class="yz-ozet" data-yz-ozet>
  <summary>
    <span class="yz-simge" aria-hidden="true"><Icon name="bot-message-square" size={18} /></span>
    <span>AI ile Özetle</span>
    <span class="yz-ok" aria-hidden="true"><Icon name="chevron-down" size={16} /></span>
  </summary>
  <ul class="yz-menu" aria-label="Yapay zekâ ile özetleme seçenekleri">
    {yzBaglantilari(url, title).map((s) => (
      <li><a href={s.adres} target="_blank" rel="noopener nofollow" data-istem={s.kopyala ? ozetIstemi(url, title) : undefined} data-ad={s.ad}><span class={`yz-ikon yz-ikon-${s.anahtar}`} aria-hidden="true" set:html={markaSvg(s.anahtar)}></span><span>{s.ad}</span></a></li>
    ))}
  </ul>
</details>
{/* Gemini'ye tıklayınca istem panoya kopyalanır, ekranın altında bildirim (Ahmet 30.10).
    Menünün DIŞINDA: kapanan <details>'in içi gizleniyor. */}
<span class="yz-bildirim" role="status" data-yz-bildirim hidden></span>
<script>
  for (const d of document.querySelectorAll('[data-yz-ozet]')) {
    document.addEventListener('click', (e) => { if (d.open && !d.contains(e.target)) d.open = false; });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary')?.focus(); }
    });
    for (const a of d.querySelectorAll('a')) {
      a.addEventListener('click', () => {
        // Gemini: bağlantı istemi taşımazsa okur panodan yapıştırsın.
        if (a.dataset.istem) {
          const b = document.querySelector('[data-yz-bildirim]');
          navigator.clipboard?.writeText(a.dataset.istem).then(() => {
            if (!b) return;
            b.textContent = `İstem panoya kopyalandı; ${a.dataset.ad || ''} sohbet kutusuna yapıştırabilirsiniz`;
            // Gemini yeni sekmede açılıyor: sekme arka plandaysa bildirim bekler,
            // okur dönünce 4 sn görünür.
            b.hidden = false;
            clearTimeout(Number(b.dataset.zaman));
            const kapat = () => { b.dataset.zaman = String(setTimeout(() => (b.hidden = true), 4000)); };
            setTimeout(() => {
              if (document.visibilityState === 'visible') return kapat();
              const don = () => {
                if (document.visibilityState !== 'visible') return;
                document.removeEventListener('visibilitychange', don);
                kapat();
              };
              document.addEventListener('visibilitychange', don);
            }, 500);
          }, () => {});
        }
        d.open = false;
      });
    }
  }
</script>
