---
import { loadBlog, NAV_MAIN } from '../lib.js';
import { merkezBaglantisiMi, YENI_SEKME, YENI_SEKME_NOTU_HTML } from '../../../blog/simulasyon.mjs';
const blog = loadBlog();
const cats = blog.categories.filter((c) => c.count);
// Dengeli alt bilgi (Ahmet 01.11: "footerı da dengeli hale getirelim"). Eskiden Blog sütunu 10
// bağlantıyla öteki sütunlardan uzundu; artık Blog yalnız yazılar ve kategoriler (8), blog dışındaki
// araç ve rehberler Keşfet'te (6). Bölüm 8, Makineler için 5 + not; sütun boyları birbirine yakın.
// Simülasyonlu Eğitim (3D) yeni sekmede açılır (Ahmet 01.11), ekran okuyucuya görünmez not (simulasyon.mjs).
const kesfet = [
  ['Simülasyonlu Eğitim', '/3d'],
  ['PDF Merkezi', '/pdf'],
  ['AGS rehberi', '/blog/ags'],
  ['AGS geri sayımı', '/blog/ags-geri-sayim'],
  ['Atıf kartı ekleme', '/blog/atif-karti-ekleme'],
  ['Editör Ekibi', blog.author.url],
];
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <section class="foot-about">
        <a class="foot-brand" href="/" aria-label="bote.web.tr ana sayfası">bote<b>.web.tr</b></a>
        <p>bote.web.tr, Bilgisayar ve Öğretim Teknolojileri Eğitimi (BÖTE) bölümünü tanıtan bir bilgi sitesidir. Bölümün programı, mezunların çalışma alanları ve öğretmenliğe giden yol hakkında bilgi sunar.</p>
      </section>
      <section>
        <h2>Bölüm</h2>
        <ul>{NAV_MAIN.map(([t, h]) => <li><a href={h}>{t}</a></li>)}</ul>
      </section>
      <section>
        <h2>Blog</h2>
        <ul>
          <li><a href="/blog">Tüm yazılar</a></li>
          {cats.map((c) => <li><a href={c.url}>{c.name}</a></li>)}
        </ul>
      </section>
      <section>
        <h2>Keşfet</h2>
        <ul>{kesfet.map(([t, h]) => merkezBaglantisiMi(h)
          ? <li><a href={h} {...YENI_SEKME}>{t}<Fragment set:html={YENI_SEKME_NOTU_HTML} /></a></li>
          : <li><a href={h}>{t}</a></li>)}</ul>
      </section>
      <section>
        <h2>Makineler için</h2>
        <p class="foot-note">Arama motorları ve yapay zekâ araçları için özet, besleme ve Markdown sürümleri.</p>
        <ul>
          <li><a href="/blog/feed.xml">RSS beslemesi</a></li>
          <li><a href="/blog/feed.json">JSON Feed</a></li>
          <li><a href="/blog/yazilar.md">Yazı dizini (Markdown)</a></li>
          <li><a href="/llms.txt">Yapay zekâ için site özeti</a></li>
          <li><a href="/sitemap.xml">Site haritası (XML)</a></li>
        </ul>
      </section>
    </div>
    <div class="foot-bottom">
      <span>© {blog.newest.slice(0, 4)} BÖTE · bote.web.tr</span>
      <span><a href="/about">Hakkımızda</a> · <a href="/contact">İletişim</a> · <a href="/site-map">Site haritası</a> · <a href="/en" hreflang="en" lang="en">English</a></span>
    </div>
  </div>
</footer>
