---
import SearchPalette from '../islands/SearchPalette.jsx';
import ThemeToggle from '../islands/ThemeToggle.jsx';
import ReadingProgress from '../islands/ReadingProgress.jsx';
import { loadBlog } from '../lib.js';
const { progress = false, current = '' } = Astro.props;
const blog = loadBlog();
const cats = blog.categories.filter((c) => c.count);
---
<header class="topbar">
  <div class="topbar-in">
    <a class="brand" href="/blog" aria-label="bote.web.tr blog ana sayfası"><span class="brand-mark">bote<b>.web.tr</b></span></a>
    <nav class="topnav" aria-label="Blog kategorileri">
      <a href="/blog" aria-current={current === 'blog' ? 'page' : undefined}>Tüm yazılar</a>
      {/* Ust menude kategorinin kisa adi (blog.yml > short); 7 kategoride tam adlar arama dugmesinin altina tasiyordu. */}
      {cats.map((c) => <a href={c.url} title={c.short ? c.name : undefined} aria-current={current === c.slug ? 'page' : undefined}>{c.short || c.name}</a>)}
    </nav>
    <div class="top-actions">
      <SearchPalette client:idle />
      <ThemeToggle client:idle />
      <a class="to-site" href="/">Ana site ↗</a>
    </div>
  </div>
  {progress && <ReadingProgress client:idle target=".prose" />}
</header>
{cats.length > 0 && (
  <nav class="chipbar" aria-label="Kategoriler (mobil)">
    <a href="/blog" aria-current={current === 'blog' ? 'page' : undefined}>Tümü</a>
    {cats.map((c) => <a href={c.url} aria-current={current === c.slug ? 'page' : undefined}>{c.name}</a>)}
    <a href="/">Ana site</a>
  </nav>
)}
