---
import SearchPalette from '../islands/SearchPalette.jsx';
import ThemeToggle from '../islands/ThemeToggle.jsx';
import ReadingProgress from '../islands/ReadingProgress.jsx';
import Icon from './Icon.astro';
import { loadBlog } from '../lib.js';
const { progress = false, current = '' } = Astro.props;
const blog = loadBlog();
const cats = blog.categories.filter((c) => c.count);
---
<header class="topbar">
  <div class="topbar-in">
    <a class="brand" href="/blog" aria-label="bote.web.tr blog ana sayfası"><span class="brand-mark">bote<b>.web.tr</b></span></a>
    <nav class="topnav" aria-label="Blog kategorileri">
      <a class="all-posts" href="/blog" aria-current={current === 'blog' ? 'page' : undefined}><Icon name="layout-grid" size={18} /><span>Tüm yazılar</span></a>
      {cats.map((c) => <a href={c.url} title={c.short ? c.name : undefined} aria-current={current === c.slug ? 'page' : undefined}><Icon name={c.icon} size={18} /><span>{c.short || c.name}</span></a>)}
    </nav>
    <div class="top-actions">
      <SearchPalette client:idle />
      <ThemeToggle client:idle />
      <details class="header-menu">
        <summary aria-label="Blog menüsünü aç"><Icon name="menu" size={20} /><span class="header-menu-label">Menü</span></summary>
        <nav aria-label="Diğer blog bağlantıları">
          <div class="mobile-category-links">
            <a href="/blog" aria-current={current === 'blog' ? 'page' : undefined}><Icon name="layout-grid" size={18} />Tüm yazılar</a>
            {cats.map((c) => <a href={c.url} aria-current={current === c.slug ? 'page' : undefined}><Icon name={c.icon} size={18} /><span>{c.name}</span></a>)}
          </div>
          <a href="/pdf" aria-current={current === 'pdf' ? 'page' : undefined}><Icon name="files" size={18} />PDF Merkezi</a>
          <a href="/"><Icon name="arrow-up-right" size={18} />Ana site</a>
        </nav>
      </details>
    </div>
  </div>
  {progress && <ReadingProgress client:idle target=".prose" />}
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.header-menu');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
