---
import SearchPalette from '../islands/SearchPalette.jsx';
import ThemeToggle from '../islands/ThemeToggle.jsx';
import ReadingProgress from '../islands/ReadingProgress.jsx';
import Icon from './Icon.astro';
import { loadBlog } from '../lib.js';
const { progress = false, current = '' } = Astro.props;
const blog = loadBlog();
const cats = blog.categories.filter((c) => c.count);
---
<header class="topbar">
  <div class="topbar-in">
    <a class="brand" href="/blog" aria-label="bote.web.tr blog ana sayfası"><span class="brand-mark">bote<b>.web.tr</b></span><span class="brand-blog">Blog</span></a>
    <div class="top-actions">
      <a class="to-site home-link" href="/">Ana site <Icon name="arrow-up-right" size={15} /></a>
      <a class="to-site pdf-link" href="/pdf" aria-current={current === 'pdf' ? 'page' : undefined}><Icon name="files" size={17} /> PDF Merkezi</a>
      <SearchPalette client:idle />
      <ThemeToggle client:idle />
    </div>
  </div>
  <div class="category-row">
    <nav class="topnav" aria-label="Blog kategorileri">
      <a href="/blog" aria-current={current === 'blog' ? 'page' : undefined}>Tüm yazılar</a>
      {cats.map((c) => <a href={c.url} title={c.short ? c.name : undefined} aria-current={current === c.slug ? 'page' : undefined}>{c.short || c.name}</a>)}
    </nav>
  </div>
  <details class="mobile-categories">
    <summary><span><Icon name="menu" size={18} />{cats.find((c) => c.slug === current)?.short || cats.find((c) => c.slug === current)?.name || 'Kategoriler'}</span><Icon name="chevron-down" size={18} /></summary>
    <nav aria-label="Mobil blog menüsü">
      <a href="/blog" aria-current={current === 'blog' ? 'page' : undefined}>Tüm yazılar <Icon name="arrow-right" size={16} /></a>
      {cats.map((c) => <a href={c.url} aria-current={current === c.slug ? 'page' : undefined}>{c.name}<span class="category-count">{c.count}</span></a>)}
      <a href="/pdf" aria-current={current === 'pdf' ? 'page' : undefined}>PDF Merkezi <Icon name="files" size={16} /></a>
      <a href="/">Ana site <Icon name="arrow-up-right" size={16} /></a>
    </nav>
  </details>
  {progress && <ReadingProgress client:idle target=".prose" />}
</header>
