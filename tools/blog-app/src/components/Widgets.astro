---
// Kenar cubugu ve yazi sonu bandi.
//   post:    yazi sayfasi sag sutunu -> reklam > icindekiler (yalniz icindekiler yapisir, kendi icinde kayar;
//            Ahmet 26.09: tum sutun alttan yapisinca yukari cikmak zorlasiyordu)
//   sidebar: liste sayfalari -> reklam > kategoriler > populer > son okunanlar > yayin ilkeleri
//   band:    yazi sonu -> populer > son okunanlar > reklam
import PopularPosts from '../islands/PopularPosts.jsx';
import RecentlyViewed from '../islands/RecentlyViewed.jsx';
import AdSlot from './AdSlot.astro';
import UniPanel from './UniPanel.astro';
import Icon from './Icon.astro';
import { loadBlog, trDate } from '../lib.js';
const { mode = 'sidebar', current = '', pool: poolProp, toc = [], noCats = false, cat = '' } = Astro.props;
const blog = loadBlog();
const adsense = blog.cfg.ads.adsense.client && blog.cfg.ads.adsense.slots?.['article-end'];
// pool: widget'larin kullandigi yazilar (varsayilan: yayindakiler; onizlemede taslaklar)
const pool = poolProp || blog.posts;
const isPreview = pool.some((p) => p.preview);
// Listeler gorselli (Ahmet 26.09): kucuk resim yazinin paylasim kapagi.
// kucuk liste gorseli: basliksiz kapak (kategori rengi + ikon); kucukte okunmayan yazili kapak yerine
const thumb = (p) => p.art?.src || p.image?.src;
const lite = pool.map((p) => ({ slug: p.slug, title: p.title, url: p.url, minutes: p.minutes, img: thumb(p) }));
const fallback = [...pool].filter((p) => p.slug !== current)
  .sort((a, b) => (b.featured - a.featured) || b.date.localeCompare(a.date)).slice(0, 5)
  .map((p) => ({ slug: p.slug, title: p.title, url: p.url, minutes: p.minutes, img: thumb(p) }));
const cats = isPreview
  ? blog.categories.map((c) => ({ ...c, url: '/blog/taslak', count: pool.filter((p) => p.category.slug === c.slug).length })).filter((c) => c.count)
  : blog.categories.filter((c) => c.count);
const curCat = (cat && cat !== 'blog' ? cat : '') || pool.find((p) => p.slug === current)?.category.slug;
const total = cats.reduce((n, c) => n + c.count, 0);
---
{mode === 'band' ? (
  <section class="band" aria-label="Diğer içerikler">
    <div class="wrap band-grid">
      <div class="band-posts">
        {isPreview ? <PopularPosts fallback={fallback} posts={[]} current={current} /> : <PopularPosts client:visible fallback={fallback} posts={lite} current={current} />}
        {!isPreview && <RecentlyViewed client:visible posts={lite} current={current} />}
      </div>
      {adsense ? <AdSlot slot="article-end" /> : <UniPanel />}
    </div>
  </section>
) : (
  <aside class={`sidebar${mode === 'post' ? ' sidebar-post' : ''}`} aria-label="Blog kenar çubuğu" data-sticky-side={mode === 'post' ? undefined : true}>
    <AdSlot slot="sidebar-top" />
    {mode !== 'post' && !noCats && cats.length > 0 && (
      <section class="widget" aria-labelledby="w-cats">
        <h2 class="widget-title" id="w-cats">Kategoriler</h2>
        <ul class="cats">
          <li class="cats-all"><a href={isPreview ? '/blog/taslak' : '/blog'} aria-current={cat === 'blog' ? 'true' : undefined}><Icon name="book-open" size={17} /><span>Tüm yazılar</span><span class="count" aria-label={`${total} yazı`}>{total}</span></a></li>
          {cats.map((c) => (
          <li><a href={c.url} aria-current={c.slug === curCat ? 'true' : undefined}><Icon name={c.icon || 'folder'} size={17} /><span>{c.name}</span><span class="count" aria-label={`${c.count} yazı`}>{c.count}</span></a></li>
        ))}
        </ul>
      </section>
    )}
    {mode === 'post' ? (
      <>
        {toc.length > 0 && (
          <nav class="widget side-toc" aria-labelledby="w-toc">
            <h2 class="widget-title" id="w-toc">İçindekiler</h2>
            <ol>{toc.map((h) => (
              <li class={h.depth === 3 ? 'sub' : undefined}><a href={`#${h.id}`}>{h.text}</a></li>
            ))}</ol>
          </nav>
        )}
      </>
    ) : (
      <>
        {isPreview ? <PopularPosts fallback={fallback} posts={[]} current={current} /> : <PopularPosts client:visible fallback={fallback} posts={lite} current={current} />}
        {!isPreview && <RecentlyViewed client:visible posts={lite} current={current} />}
        <section class="widget note-box" aria-labelledby="w-about">
          <h2 class="widget-title" id="w-about">BÖTE hakkında</h2>
          <p>Bilgisayar ve Öğretim Teknolojileri Eğitimi; bilişim bilgisini öğretmenlik ve eğitim teknolojileriyle birleştiren dört yıllık bir lisans programıdır.</p>
          <a href="/about">Bölümü tanıyın →</a>
        </section>
      </>
    )}
  </aside>
)}
<script>
  // Liste sayfalari: kenar cubugu ekrana sigiyorsa ust bara yapisir; sigmiyorsa normal akar.
  // (Alttan yapiskan davranis yukari cikarken kenar cubugunu kilitliyordu; Ahmet 26.09.)
  const side = document.querySelector('[data-sticky-side]');
  if (side) {
    const wide = matchMedia('(min-width: 1000px)');
    const fit = () => {
      const bar = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--top')) || 64;
      const ok = wide.matches && side.offsetHeight + bar + 40 <= innerHeight;
      side.style.position = ok ? 'sticky' : 'static';
      side.style.top = ok ? `${bar + 24}px` : '';
    };
    new ResizeObserver(fit).observe(side);
    addEventListener('resize', fit);
    fit();
  }
</script>
