---
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
import PostCard from './PostCard.astro';
import Widgets from './Widgets.astro';
import SourceList from './SourceList.astro';
import Icon from './Icon.astro';
import ViewCount from '../islands/ViewCount.jsx';
import ShareBar from '../islands/ShareBar.jsx';
import CitationPeek from '../islands/CitationPeek.jsx';
import { loadBlog, orgLd, teamLd, breadcrumbLd, trDate, isoDate, icon } from '../lib.js';
import { renderInline } from '../../../blog/markdown.mjs';
import { stripHtml } from '../../../blog/util.mjs';

// Yazi sayfasi. list: onceki/sonraki ve ilgili yazilarin secildigi liste
// (yayindakiler ya da taslak onizlemeleri). preview: noindex taslak onizlemesi.
const { post, list, preview = false } = Astro.props;
const blog = loadBlog();
const i = list.indexOf(post);
const newer = list[i - 1];
const older = list[i + 1];
const related = [...list.filter((p) => p !== post && p.category.slug === post.category.slug),
  ...list.filter((p) => p !== post && p.category.slug !== post.category.slug)].slice(0, 3);
const trail = preview
  ? [{ name: 'Ana Sayfa', url: '/' }, { name: 'Blog', url: '/blog' }, { name: 'Taslak önizleme', url: '/blog/taslak' }, { name: post.title, url: post.url }]
  : [{ name: 'Ana Sayfa', url: '/' }, { name: 'Blog', url: '/blog' }, { name: post.category.name, url: post.category.url }, { name: post.title, url: post.url }];
// "Kisaca" ozeti yazinin sonuna, kontrol listesinden ya da Sonuc'tan hemen once yerlesir.
const recap = post.summary.length ? post.headings.find((h) => h.depth === 2 && /kontrol listesi|^sonuç/i.test(h.text)) : null;
const recapItem = { id: 'kisaca', text: 'Kısaca', depth: 2 };
const html = post.html;
const firstH2 = html.indexOf('<h2 ');
const cut = recap ? html.indexOf(`<h2 id="${recap.id}">`) : html.length;
const intro = firstH2 > 0 ? html.slice(0, firstH2) : '';
const middle = html.slice(Math.max(firstH2, 0), cut);
const ending = html.slice(cut);
const bodyHeads = post.headings.flatMap((h) => (recap && h === recap ? [recapItem, h] : [h]));
const tocItems = [...bodyHeads, ...(post.summary.length && !recap ? [recapItem] : []),
  ...(post.faq.length ? [{ id: 'sss', text: 'Sık sorulan sorular', depth: 2 }] : []), { id: 'kaynaklar', text: `Kaynaklar (${post.sources.length})`, depth: 2 },
  { id: 'atif', text: 'Bu yazıya atıf', depth: 2 }];
const url = blog.abs(post.url);
// "Bu yaziya atif": APA 7 (grup yazar, blog yazisi; tarih = son guncelleme) ve BibTeX.
const AY = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const [cy, cm, cd] = post.updated.split('-').map(Number);
const apaHtml = `${blog.author.name}. (${cy}, ${cd} ${AY[cm - 1]}). ${post.citeTitle}. <i>BÖTE Blog</i>. ${url}`;
const bibtex = `@online{bote-${post.slug},
  author       = {{${blog.author.name}}},
  title        = {${post.title}},
  organization = {BÖTE Blog},
  year         = {${cy}},
  date         = {${post.updated}},
  url          = {${url}},
  langid       = {turkish}
}`;
const ld = { '@context': 'https://schema.org', '@graph': [
  {
    '@type': 'BlogPosting', '@id': `${url}#yazi`, mainEntityOfPage: url, url,
    headline: post.title, description: post.description, inLanguage: 'tr-TR',
    image: { '@type': 'ImageObject', url: blog.abs(post.image.src), width: post.image.width, height: post.image.height },
    datePublished: isoDate(post.date), dateModified: isoDate(post.updated),
    author: { '@type': 'Organization', '@id': blog.author.id, name: blog.author.name, url: blog.abs(blog.author.url) },
    publisher: { '@id': `${blog.SITE}/#org` }, isPartOf: { '@id': `${blog.SITE}/blog#blog` },
    articleSection: post.category.name, keywords: post.tags.join(', '), wordCount: post.words, timeRequired: `PT${post.minutes}M`,
    citation: post.sources.map((s) => ({
      '@type': 'CreativeWork', name: s.title, url: s.url, inLanguage: s.lang,
      ...(s.author ? { author: { '@type': 'Organization', name: s.author } } : {}),
      ...(s.publisher ? { publisher: { '@type': 'Organization', name: s.publisher } } : {}),
      ...(/^\d{4}$/.test(s.year) ? { datePublished: s.year } : {}),
    })),
  },
  orgLd(blog), teamLd(blog), breadcrumbLd(blog, trail),
  ...(post.faq.length ? [{ '@type': 'FAQPage', mainEntity: post.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripHtml(renderInline(f.a)) } })) }] : []),
] };
---
<Base title={preview ? `Taslak: ${post.title}` : post.title.length <= 48 ? `${post.title} | BÖTE Blog` : post.title} description={post.description} path={post.url}
  image={post.image} imageAlt={post.imageAlt} type="article" ld={ld} slug={preview ? undefined : post.slug} progress noindex={preview}
  current={preview ? '' : post.category.slug} mdAlt={preview ? undefined : `${post.url}.md`}>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate(post.date)}>
    <meta property="article:modified_time" content={isoDate(post.updated)}>
    <meta property="article:section" content={post.category.name}>
  </Fragment>
  <div class="wrap post-layout">
  <article class="post-main" aria-labelledby="yazi-basligi">
    <header class="post-head">
      <Crumbs items={trail} />
      <a class="badge" href={post.category.url}>{post.category.name}</a>
      <h1 id="yazi-basligi" style={`view-transition-name: t-${post.slug}`}>{post.title}</h1>
      <p class="dek">{post.description}</p>
      <div class="byline">
        <a class="author" href={blog.author.url} rel="author">
          <span class="avatar"><Icon name="user-round" size={18} /></span>
          <span class="who"><b>{blog.author.name}</b><small>Yazar</small></span>
        </a>
        <span class="m"><Icon name="calendar" size={16} /><time datetime={post.date}>{trDate(post.date)}</time></span>
        {post.updated !== post.date && <span class="m"><Icon name="refresh-cw" size={16} />güncellendi <time datetime={post.updated}>{trDate(post.updated)}</time></span>}
        <span class="m"><Icon name="clock" size={16} />{post.minutes} dk okuma</span>
        {!preview && <ViewCount client:idle slug={post.slug} count icon={icon('eye', { size: 16 })} />}
      </div>
    </header>
    <div class="post-body">
      {post.art && (
        <figure class="post-art">
          <img src={post.art.src} width={post.art.width} height={post.art.height} alt={`${post.title} yazısının kapak görseli`} fetchpriority="high" decoding="async" style={`view-transition-name: c-${post.slug}`} />
        </figure>
      )}
      <div class="prose">
        {post.draft && <p class="draft-banner">TASLAK · editör onayı bekliyor. Bu önizleme arama motorlarına kapalıdır ve siteden bağlantı almaz.</p>}
        <Fragment set:html={intro} />
        <nav class="toc-card" aria-labelledby="icindekiler">
          <div class="toc-card-head">
            <h2 id="icindekiler" class="toc-card-title"><Icon name="list" size={16} />İçindekiler</h2>
            <span class="toc-card-count">{tocItems.length} bölüm</span>
          </div>
          <ol>{tocItems.map((h, i) => <li class={h.depth === 3 ? 'sub' : undefined}><a href={`#${h.id}`}><span class="num">{String(i + 1).padStart(2, '0')}</span><span>{h.text}</span></a></li>)}</ol>
        </nav>
        <Fragment set:html={middle} />
        {post.summary.length > 0 && (
          <section class="tldr" aria-labelledby="kisaca">
            <h2 id="kisaca">Kısaca</h2>
            <ul>{post.summary.map((s) => <li set:html={renderInline(s)} />)}</ul>
          </section>
        )}
        <Fragment set:html={ending} />
        {post.faq.length > 0 && (
          <section class="faq" aria-labelledby="sss">
            <h2 id="sss">Sık sorulan sorular</h2>
            {post.faq.map((f) => <details class="qa"><summary><h3>{f.q}</h3></summary><p set:html={renderInline(f.a)} /></details>)}
          </section>
        )}
        <section class="bib" id="kaynaklar" aria-labelledby="kaynaklar-baslik">
          <div class="bib-head">
            <div class="bib-title">
            <h2 id="kaynaklar-baslik">Kaynaklar <span class="bib-count">{post.sources.length}</span></h2>
            {post.sources.length > 2 && <button type="button" class="bib-less" data-bib-less hidden>Daha az göster</button>}
          </div>
            <details class="bib-settings" data-bib-settings hidden>
              <summary><Icon name="settings-2" size={16} />Kaynakça ayarları</summary>
              <div class="bib-settings-body">
                <label class="switch"><input type="checkbox" data-pref="cites" /><span>Metinde atıf numaralarını göster</span></label>
                <label class="switch"><input type="checkbox" data-pref="backrefs" /><span>Kaynakçada “Metinde göster” bağlantıları</span></label>
                <p>İkisi de varsayılan olarak kapalıdır; seçiminiz bu tarayıcıda hatırlanır.</p>
              </div>
            </details>
          </div>
          <SourceList sources={post.sources} />
        </section>
        <section class="cite-box" id="atif" aria-labelledby="atif-baslik">
          <h2 id="atif-baslik">Bu yazıya atıf</h2>
          <p class="cite-fmt">APA 7</p>
          <p class="cite-apa" data-copy-src="apa" set:html={apaHtml} />
          <div class="cite-actions">
            <button type="button" class="cite-btn" data-copy="apa" hidden><Icon name="copy" size={15} /><span>APA'yı kopyala</span></button>
            <details class="cite-bib">
              <summary>BibTeX</summary>
              <pre data-copy-src="bibtex">{bibtex}</pre>
              <button type="button" class="cite-btn" data-copy="bibtex" hidden><Icon name="copy" size={15} /><span>BibTeX'i kopyala</span></button>
            </details>
          </div>
          <div class="changelog">
            <h3>Son güncelleme: <time datetime={post.updated}>{trDate(post.updated)}</time></h3>
            {post.changes.length > 0 && (
              <ul>{post.changes.map((c) => <li><time datetime={c.date}>{trDate(c.date)}</time> · <span set:html={renderInline(c.text)} /></li>)}</ul>
            )}
          </div>
        </section>
        <ShareBar client:visible url={url} title={post.title} />
      </div>
      {(newer || older) && (
        <nav class="prevnext" aria-label="Diğer yazılar">
          {older ? <a href={older.url}><span>← Önceki yazı</span>{older.title}</a> : <span />}
          {newer && <a class="next" href={newer.url}><span>Sonraki yazı →</span>{newer.title}</a>}
        </nav>
      )}
      {related.length > 0 && (
        <section class="related" aria-labelledby="ilgili">
          <h2 id="ilgili">İlgili yazılar</h2>
          <ol class="rows">{related.map((p) => <li><PostCard post={p} /></li>)}</ol>
        </section>
      )}
    </div>
  </article>
  <Widgets mode="post" current={post.slug} pool={list} toc={tocItems} />
  </div>
  <Widgets mode="band" current={post.slug} pool={list} />
  <CitationPeek client:idle />
  <script>
    // Kaynakca ayarlari: atif numaralari ve "Metinde goster" baglantilari varsayilan kapali
    // (html[data-cites="on"], html[data-backrefs="on"] ile acilir, tarayicida hatirlanir).
    const root = document.documentElement;
    const box = document.querySelector('[data-bib-settings]');
    if (box) {
      box.hidden = false;
      for (const input of box.querySelectorAll('input[data-pref]')) {
        const key = input.dataset.pref;
        input.checked = root.dataset[key] === 'on';
        input.addEventListener('change', () => {
          root.dataset[key] = input.checked ? 'on' : 'off';
          try { localStorage.setItem(`bote-${key}`, root.dataset[key]); } catch {}
        });
      }
    }
    // Kaynak listesi acikken "Daha az goster" baslikta, sayinin yaninda durur.
    const more = document.querySelector('.src-more');
    const less = document.querySelector('[data-bib-less]');
    if (more && less) {
      document.getElementById('kaynaklar')?.classList.add('js-less');
      const sync = () => { less.hidden = !more.open; };
      more.addEventListener('toggle', sync);
      less.addEventListener('click', () => { more.open = false; document.getElementById('kaynaklar')?.scrollIntoView({ block: 'start' }); });
      sync();
    }
    // Atif metnini panoya kopyala (JS yoksa dugmeler gizli kalir; metin secilip kopyalanabilir).
    for (const btn of document.querySelectorAll('[data-copy]')) {
      const src = document.querySelector(`[data-copy-src="${btn.dataset.copy}"]`);
      if (!src || !navigator.clipboard) continue;
      btn.hidden = false;
      const label = btn.querySelector('span');
      const text = label.textContent;
      btn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(src.innerText.trim()); label.textContent = 'Kopyalandı'; }
        catch { label.textContent = 'Kopyalanamadı'; }
        setTimeout(() => { label.textContent = text; }, 1800);
      });
    }
    // Bilgi penceresindeki bir bolume gidilince pencereyi kapat.
    for (const a of document.querySelectorAll('.src-pop a[href^="#"]')) {
      a.addEventListener('click', () => a.closest('[popover]')?.hidePopover?.());
    }
    // Kapali bir listedeki hedefe (#kaynak-3, #sss ...) gidilirse listeyi ac.
    const reveal = () => {
      const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      const d = el?.closest('details');
      if (d && !d.open) { d.open = true; el.scrollIntoView(); }
    };
    addEventListener('hashchange', reveal);
    reveal();
    // Icindekiler: okunan bolumu isaretle.
    // Icindekiler karti ve kenar cubugu ayni bolumleri gosterir; okunan bolum ikisinde de isaretlenir.
    const links = [...document.querySelectorAll('.side-toc a')];
    const cardLinks = [...document.querySelectorAll('.toc-card a')];
    const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean);
    let active = -1, raf = 0;
    const mark = () => {
      raf = 0;
      let i = 0;
      heads.forEach((h, k) => { if (h.getBoundingClientRect().top < 140) i = k; });
      if (i !== active) {
        for (const set of [links, cardLinks]) { set[active]?.removeAttribute('aria-current'); set[i]?.setAttribute('aria-current', 'true'); }
        active = i;
      }
    };
    if (heads.length) { addEventListener('scroll', () => { raf ||= requestAnimationFrame(mark); }, { passive: true }); mark(); }
  </script>
</Base>
