---
// Reklam alani. AdSense (blog.yml > ads.adsense) doluysa AdSense, degilse site ici tanitim karti.
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';
import { loadBlog } from '../lib.js';
import { ROOT } from '../../../blog/content.mjs';
const { slot } = Astro.props;
const ads = loadBlog().cfg.ads;
const client = ads.adsense.client;
const slotId = ads.adsense.slots?.[slot];
const house = (ads.house || []).find((h) => (h.slots || []).includes(slot));
// Logo: tam adres (https://...) dogrudan kullanilir; yerel yol public/ altinda varsa kullanilir;
// ikisi de yoksa yazi logosu.
const external = /^https:\/\//.test(house?.logo || '');
const logoFile = house?.logo && !external && path.join(ROOT, 'tools/blog-app/public', house.logo.replace(/^\/blog\//, ''));
const logo = external ? house.logo : logoFile && fs.existsSync(logoFile) ? house.logo : null;
// koyu tema logosu yalniz tam adres olarak kabul edilir (acik logo da simdilik dis adres)
const logoDark = logo && /^https:\/\//.test(house?.logoDark || '') ? house.logoDark : null;
const STORES = {
  appstore: { badge: '/blog/ads/app-store.png', w: 241, icon: 'apple', top: 'Download on the', name: 'App Store', label: "App Store'dan indir" },
  googleplay: { badge: '/blog/ads/google-play.png', w: 269, icon: 'googleplay', top: 'GET IT ON', name: 'Google Play', label: "Google Play'den indir" },
  appgallery: { badge: '/blog/ads/appgallery.png', w: 266, icon: 'appgallery', top: 'EXPLORE IT ON', name: 'AppGallery', label: "AppGallery'den indir" },
};
---
{client && slotId ? (
  <aside class="ad" data-ad-slot={slot} aria-label="Reklam">
    <span class="ad-label">Reklam</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slotId} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
) : house ? (
  <aside class="promo" aria-label={`${house.brand} iş birliği`}>
    <div class="promo-card">
      <span class="promo-tag">İş birliği</span>
      <a class="promo-logo" href={house.url} rel="sponsored noopener" target="_blank" aria-label={`${house.brand} web sitesi`}>
        {logo ? (
          <>
            <img class={logoDark ? 'lg-light' : undefined} src={logo} alt={house.brand} height="40" loading="lazy" decoding="async" onerror="this.hidden=true;this.parentNode.querySelector('.promo-wordmark').hidden=false" />
            {logoDark && <img class="lg-dark" src={logoDark} alt={house.brand} height="40" loading="lazy" decoding="async" onerror="this.hidden=true;this.parentNode.querySelector('.promo-wordmark').hidden=false" />}
            <span class="promo-wordmark" hidden>Uni<b>Connectly</b></span>
          </>
        ) : <span class="promo-wordmark">Uni<b>Connectly</b></span>}
      </a>
      <p class="promo-text">{house.text}</p>
      <a class="promo-cta" href={house.url} rel="sponsored noopener" target="_blank">{house.cta}</a>
      {house.stores?.length > 0 && (
        <div class="promo-stores">
          {house.stores.filter((s) => STORES[s.id]).map((s) => (
            <a class="store" href={s.url} rel="sponsored noopener" target="_blank" aria-label={`${house.brand}: ${STORES[s.id].label}`}>
              <img src={STORES[s.id].badge} alt={STORES[s.id].label} width={STORES[s.id].w} height="80" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      )}
    </div>
  </aside>
) : null}
