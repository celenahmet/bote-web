---
// Reklam alani. AdSense (blog.yml > ads.adsense) doluysa AdSense, degilse site ici tanitim karti.
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';
import { loadBlog } from '../lib.js';
import { ROOT } from '../../../blog/content.mjs';
const { slot } = Astro.props;
const ads = loadBlog().cfg.ads;
const client = ads.adsense.client;
const slotId = ads.adsense.slots?.[slot];
// Ayni alana birden cok tanitim karti verilebilir; 15 sn'de bir doner (ilk kart sabit HTML'de gorunur).
const houses = (ads.house || []).filter((h) => (h.slots || []).includes(slot));
const house = houses[0];
// Logo: tam adres (https://...) ya da public/ altindaki yerel yol (/blog/ads/...). Ikisi de yoksa yazi logosu.
const logoBul = (adres) => {
  if (!adres) return null;
  if (/^https:\/\//.test(adres)) return adres;
  const dosya = path.join(ROOT, 'tools/blog-app/public', adres.replace(/^\/blog\//, ''));
  return fs.existsSync(dosya) ? adres : null;
};
const kartlar = houses.map((h) => {
  const logo = logoBul(h.logo);
  return { ...h, logo, logoDark: logo && logoBul(h.logoDark) };
});
const STORES = {
  appstore: { badge: '/blog/ads/app-store.png', w: 241, icon: 'apple', top: 'Download on the', name: 'App Store', label: "App Store'dan indir" },
  googleplay: { badge: '/blog/ads/google-play.png', w: 269, icon: 'googleplay', top: 'GET IT ON', name: 'Google Play', label: "Google Play'den indir" },
  appgallery: { badge: '/blog/ads/appgallery.png', w: 266, icon: 'appgallery', top: 'EXPLORE IT ON', name: 'AppGallery', label: "AppGallery'den indir" },
};
---
{client && slotId ? (
  <aside class="ad" data-ad-slot={slot} aria-label="Reklam">
    <span class="ad-label">Reklam</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slotId} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
) : house ? (
  <aside class="promo" aria-label="İş birliği" data-promo-donen={kartlar.length > 1 ? '' : undefined}>
    {kartlar.map((h, i) => (
    <div class="promo-card" hidden={i > 0}>
      <span class="promo-tag">İş birliği</span>
      <a class="promo-logo" href={h.url} rel="sponsored noopener" target="_blank" aria-label={`${h.brand} web sitesi`}>
        {h.logo ? (
          <>
            <img class={h.logoDark ? 'lg-light' : undefined} src={h.logo} alt={h.brand} height="40" loading="lazy" decoding="async" onerror="this.hidden=true;this.parentNode.querySelector('.promo-wordmark').hidden=false" />
            {h.logoDark && <img class="lg-dark" src={h.logoDark} alt={h.brand} height="40" loading="lazy" decoding="async" onerror="this.hidden=true;this.parentNode.querySelector('.promo-wordmark').hidden=false" />}
            <span class="promo-wordmark" hidden>{h.id === 'uniconnectly' ? <>Uni<b>Connectly</b></> : h.brand}</span>
          </>
        ) : <span class="promo-wordmark">{h.id === 'uniconnectly' ? <>Uni<b>Connectly</b></> : h.brand}</span>}
      </a>
      <p class="promo-text">{h.text}</p>
      <a class="promo-cta" href={h.url} rel="sponsored noopener" target="_blank">{h.cta}</a>
      {h.stores?.length > 0 && (
        <div class="promo-stores">
          {h.stores.filter((st) => STORES[st.id]).map((st) => (
            <a class="store" href={st.url} rel="sponsored noopener" target="_blank" aria-label={`${h.brand}: ${STORES[st.id].label}`}>
              <img src={STORES[st.id].badge} alt={STORES[st.id].label} width={STORES[st.id].w} height="80" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      )}
    </div>
    ))}
    {kartlar.length > 1 && (
      <script is:inline>
        (function () {
          document.querySelectorAll('[data-promo-donen]').forEach(function (kutu) {
            if (kutu.dataset.kuruldu) return;
            kutu.dataset.kuruldu = '1';
            var kartlar = kutu.querySelectorAll('.promo-card'), i = 0, dur = false;
            kutu.addEventListener('mouseenter', function () { dur = true; });
            kutu.addEventListener('mouseleave', function () { dur = false; });
            kutu.addEventListener('focusin', function () { dur = true; });
            kutu.addEventListener('focusout', function () { dur = false; });
            setInterval(function () {
              if (dur || document.hidden) return;
              kartlar[i].hidden = true; i = (i + 1) % kartlar.length; kartlar[i].hidden = false;
            }, 15000);
          });
        })();
      </script>
    )}
  </aside>
) : null}
