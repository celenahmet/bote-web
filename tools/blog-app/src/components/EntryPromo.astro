---
import { loadBlog } from '../lib.js';
import { promoUrl } from '../promo.js';
import Icon from './Icon.astro';
const ads = loadBlog().cfg.ads;
const house = ads.house?.find((h) => h.id === 'uniconnectly');
const items = ads.showcase?.tabs?.[0]?.items?.slice(0, 4) || [];
const stores = {
  appstore: { image: 'app-store.png', width: 241, label: "App Store'dan indir" },
  googleplay: { image: 'google-play.png', width: 269, label: "Google Play'den indir" },
  appgallery: { image: 'appgallery.png', width: 266, label: "AppGallery'den indir" },
};
const ext = { target: '_blank', rel: 'sponsored noopener' };
---
{house && <dialog class="entry-promo" aria-labelledby="entry-promo-title">
  <button class="entry-promo-close" type="button" aria-label="Tanıtımı kapat">×</button>
  <span class="promo-tag">İş birliği</span>
  <a class="promo-logo" href={promoUrl(house.url)} {...ext} aria-label="UniConnectly web sitesi">
    <img class={house.logoDark ? 'lg-light' : undefined} src={house.logo} alt="UniConnectly" height="40" />
    {house.logoDark && <img class="lg-dark" src={house.logoDark} alt="UniConnectly" height="40" />}
  </a>
  <p class="entry-promo-kicker">Ücretsiz indir ve kaydol</p>
  <h2 id="entry-promo-title">Üniversite hayatının fırsatları tek uygulamada</h2>
  <ul class="entry-promo-benefits">
    {items.map((item, i) => <li><span class="entry-promo-icon"><Icon name={['file-text', 'badge-check', 'bell', 'briefcase'][i]} size={24} /></span><div><b>{item.title}</b><p>{item.text}</p></div></li>)}
  </ul>
  <div class="promo-stores">
    {(house.stores || []).filter((s) => stores[s.id]).map((s) => <a class="store" href={promoUrl(s.url)} {...ext} aria-label={`UniConnectly: ${stores[s.id].label}`}><img src={`/blog/ads/${stores[s.id].image}`} alt={stores[s.id].label} width={stores[s.id].width} height="80" /></a>)}
  </div>
  <a class="uc-btn uc-primary" href={promoUrl(house.url)} {...ext}>UniConnectly'yi keşfet <Icon name="arrow-right" size={16} /></a>
</dialog>}
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.entry-promo');
  const key = 'bote-entry-promo-dismissed-v1';
  let dismissed = false;
  try { dismissed = sessionStorage.getItem(key) === '1'; } catch {}
  if (dialog && !dismissed && typeof dialog.showModal === 'function') {
    const titles = ['Üniversite hayatının fırsatları tek uygulamada', 'CV’ni güncelle, PDF’ini hemen indir', 'Kampüsü keşfet, kariyerine bir adım at', 'Staj, iş ve etkinlik fırsatlarını kaçırma'];
    const heading = dialog.querySelector('h2')!;
    let index = Math.floor(Math.random() * titles.length);
    heading.textContent = titles[index];
    const previousFocus = document.activeElement;
    dialog.querySelector('button')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
    dialog.showModal();
    document.documentElement.classList.add('entry-promo-open');
    const timer = window.setInterval(() => {
      if (document.hidden || !dialog.open) return;
      index = (index + 1) % titles.length;
      heading.textContent = titles[index];
    }, 7000);
    dialog.addEventListener('close', () => {
      clearInterval(timer);
      try { sessionStorage.setItem(key, '1'); } catch {}
      document.documentElement.classList.remove('entry-promo-open');
      dialog.remove();
      if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
    });
    dialog.querySelector<HTMLButtonElement>('button')!.focus({ preventScroll: true });
  }
</script>
