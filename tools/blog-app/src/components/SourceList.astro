---
// Kaynakca: ilk iki kaynak gorunur; fazlasi "Tumunu gor" ile acilir (JS'siz <details>).
import SourceItem from './SourceItem.astro';
const { sources } = Astro.props;
const head = sources.slice(0, 2);
const rest = sources.slice(2);
---
<ol class="src-list">{head.map((s) => <SourceItem s={s} />)}</ol>
{rest.length > 0 && (
  <details class="src-more">
    <summary><span class="more">Tümünü gör · {rest.length} kaynak daha</span><span class="less">Daha az göster</span></summary>
    <ol class="src-list" start="3">{rest.map((s) => <SourceItem s={s} />)}</ol>
  </details>
)}
