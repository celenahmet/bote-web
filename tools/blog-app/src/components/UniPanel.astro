---
// Yazi sonundaki UniConnectly is birligi paneli (yatay): ustte tanitim + 3 adim, ortada hedef
// kitleye gore sekmeli kazanimlar (3 sutun), altta magaza rozetleri ve dugmeler. Sekmeler JS'siz calisir (radyo dugmeleri + CSS).
import Icon from './Icon.astro';
import { loadBlog } from '../lib.js';
const ads = loadBlog().cfg.ads;
const sc = ads.showcase;
const house = (ads.house || [])[0] || {};
const STORES = {
  appstore: { badge: '/blog/ads/app-store.png', w: 241, icon: 'apple', name: 'App Store', label: "App Store'dan indir" },
  googleplay: { badge: '/blog/ads/google-play.png', w: 269, icon: 'googleplay', name: 'Google Play', label: "Google Play'den indir" },
  appgallery: { badge: '/blog/ads/appgallery.png', w: 266, icon: 'appgallery', name: 'AppGallery', label: "AppGallery'den indir" },
};
const ext = { rel: 'sponsored noopener', target: '_blank' };
---
{sc && (
  <aside class="uc" aria-label="UniConnectly iş birliği">
    <span class="promo-tag uc-tag">İş birliği</span>
    <div class="uc-head">
      <div class="uc-intro">
        <div class="uc-brand">
          <a class="uc-logo" href={sc.url} {...ext} aria-label="UniConnectly web sitesi">
            {house.logo ? (
              <>
                <img class={house.logoDark ? 'lg-light' : undefined} src={house.logo} alt="UniConnectly" height="40" loading="lazy" decoding="async" onerror="this.hidden=true;this.parentNode.querySelector('.promo-wordmark').hidden=false" />
                {house.logoDark && <img class="lg-dark" src={house.logoDark} alt="UniConnectly" height="40" loading="lazy" decoding="async" onerror="this.hidden=true;this.parentNode.querySelector('.promo-wordmark').hidden=false" />}
                <span class="promo-wordmark" hidden>Uni<b>Connectly</b></span>
              </>
            ) : <span class="promo-wordmark">Uni<b>Connectly</b></span>}
          </a>
          <div>
            <p class="uc-kicker">{sc.kicker}</p>
            <p class="uc-title">{sc.title}</p>
          </div>
        </div>
        <p class="uc-text">{sc.text}</p>
      </div>
      <ol class="uc-steps">
        {sc.steps.map((st, i) => <li><span class="uc-n">{i + 1}</span><span><b>{st.title}</b><small>{st.text}</small></span></li>)}
      </ol>
    </div>
    <div class="uc-tabs">
      {sc.tabs.map((t, i) => <input type="radio" name="uc-tab" id={`uc-t${i}`} class="uc-radio sr-only" checked={i === 0} />)}
      <div class="uc-switch">
        {sc.tabs.map((t, i) => <label for={`uc-t${i}`}>{t.label}</label>)}
      </div>
      <div class="uc-panels">
        {sc.tabs.map((t, i) => (
          <div class={`uc-panel uc-p${i}`}>
            <p class="uc-q">{t.question}</p>
            <ul class="uc-cards">
              {t.items.map((it) => (
                <li>
                  <b><span class="uc-check"><Icon name="check" size={12} /></span>{it.title}</b>
                  <small>{it.text}{it.example && <> <a href={it.exampleUrl} {...ext}>Örneği gör: {it.example}</a></>}</small>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="uc-foot">
      <div class="uc-get" aria-label="Ücretsiz indir">
        <div class="promo-stores">
          {(house.stores || []).filter((s) => STORES[s.id]).map((s) => (
            <a class="store" href={s.url} {...ext} aria-label={`UniConnectly: ${STORES[s.id].label}`}>
              <img src={STORES[s.id].badge} alt={STORES[s.id].label} width={STORES[s.id].w} height="80" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      </div>
      <div class="uc-actions">
        <a class="uc-btn uc-ghost" href={sc.blog} {...ext}>UniConnectly Blog <Icon name="arrow-right" size={16} /></a>
        <a class="uc-btn uc-primary" href={sc.url} {...ext}>UniConnectly'yi keşfet <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </aside>
)}
