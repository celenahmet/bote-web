---
// Baska sitelerde iframe ile gosterilen atif karti: /blog/embed/<yazi>
// noindex (asil sayfa yazinin kendisi; canonical ona gider), sitemap disi, cerceveye izinli (vercel.json).
import { loadBlog, trDate } from '../../lib.js';
import { citation } from '../../../../blog/cite.mjs';

export function getStaticPaths() {
  return loadBlog().posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const blog = loadBlog();
const cite = citation(post, blog);
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, follow" />
  <title>{`Atıf kartı: ${post.title} | BÖTE Blog`}</title>
  <meta name="description" content={post.description} />
  <link rel="canonical" href={cite.url} />
  <style is:inline>
    :root{--bg:#FFFFFF;--ink:#1B1426;--ink-2:#3B3250;--muted:#625A74;--line:#E6E0EF;--raised:#F3EFFA;--violet:#5A2BC4;--pink:#C8205F;color-scheme:light}
    @media (prefers-color-scheme:dark){:root{--bg:#151020;--ink:#F1ECF8;--ink-2:#D4CBE2;--muted:#A197B5;--line:#2B2338;--raised:#1D1629;--violet:#B9A1FF;--pink:#FF7EAD;color-scheme:dark}}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
    .card{border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin:2px}
    .brand{display:flex;justify-content:space-between;gap:8px;font:600 11.5px ui-monospace,Menlo,Consolas,monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
    .brand b{color:var(--violet)}
    h1{font-size:18px;line-height:1.3;margin:8px 0 4px}
    h1 a{color:var(--ink);text-decoration:none}
    h1 a:hover{color:var(--pink)}
    .meta{margin:0 0 10px;font-size:13px;color:var(--muted)}
    .label{margin:12px 0 4px;font:600 11px ui-monospace,Menlo,Consolas,monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
    .apa{margin:0;padding:9px 11px;background:var(--raised);border-radius:9px;color:var(--ink-2);overflow-wrap:anywhere}
    details{margin-top:10px}
    summary{cursor:pointer;font-weight:600;color:var(--violet)}
    pre{margin:6px 0 0;padding:9px 11px;background:var(--raised);border-radius:9px;font:12.5px/1.5 ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;color:var(--ink-2)}
    .read{display:inline-block;margin-top:12px;font-weight:600;color:var(--violet);text-decoration:none}
    .read:hover{color:var(--pink)}
  </style>
</head>
<body>
  <article class="card">
    <div class="brand"><span><b>BÖTE Blog</b> · Atıf kartı</span><span>{post.category.name}</span></div>
    <h1><a href={cite.url} target="_blank" rel="noopener">{post.title}</a></h1>
    <p class="meta">{blog.author.name} · Son güncelleme: <time datetime={post.updated}>{trDate(post.updated)}</time> · {post.minutes} dk okuma</p>
    <p class="label">APA 7</p>
    <p class="apa" set:html={cite.apaHtml} />
    <details>
      <summary>BibTeX</summary>
      <pre>{cite.bibtex}</pre>
    </details>
    <a class="read" href={cite.url} target="_blank" rel="noopener">Yazıyı bote.web.tr'de oku →</a>
  </article>
</body>
</html>
