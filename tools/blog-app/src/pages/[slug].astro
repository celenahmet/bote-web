---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import PostCard from '../components/PostCard.astro';
import Widgets from '../components/Widgets.astro';
import ViewCount from '../islands/ViewCount.jsx';
import ShareBar from '../islands/ShareBar.jsx';
import CitationPeek from '../islands/CitationPeek.jsx';
import { loadBlog, sourceLine, orgLd, teamLd, breadcrumbLd, trDate, isoDate } from '../lib.js';
import { renderInline } from '../../../blog/markdown.mjs';
import { stripHtml } from '../../../blog/util.mjs';

export function getStaticPaths() {
  return loadBlog().posts.map((p) => ({ params: { slug: p.slug } }));
}

const blog = loadBlog();
const i = blog.posts.findIndex((p) => p.slug === Astro.params.slug);
const post = blog.posts[i];
const newer = blog.posts[i - 1];
const older = blog.posts[i + 1];
const related = [...blog.posts.filter((p) => p !== post && p.category.slug === post.category.slug),
  ...blog.posts.filter((p) => p !== post && p.category.slug !== post.category.slug)].slice(0, 3);
const trail = [{ name: 'Ana Sayfa', url: '/' }, { name: 'Blog', url: '/blog' }, { name: post.category.name, url: post.category.url }, { name: post.title, url: post.url }];
const lastCheck = post.sources.reduce((m, s) => (s.accessed > m ? s.accessed : m), post.date);
const h2s = post.headings.filter((h) => h.depth === 2);
const tocItems = [...(post.summary.length ? [{ id: 'kisaca', text: 'Kısaca' }] : []), ...h2s, ...(post.faq.length ? [{ id: 'sss', text: 'Sık sorulan sorular' }] : []), { id: 'kaynaklar', text: 'Kaynaklar' }];
const url = blog.abs(post.url);
const ld = { '@context': 'https://schema.org', '@graph': [
  {
    '@type': 'BlogPosting', '@id': `${url}#yazi`, mainEntityOfPage: url, url,
    headline: post.title, description: post.description, inLanguage: 'tr-TR',
    image: { '@type': 'ImageObject', url: blog.abs(post.image.src), width: post.image.width, height: post.image.height },
    datePublished: isoDate(post.date), dateModified: isoDate(post.updated),
    author: { '@type': 'Organization', '@id': blog.author.id, name: blog.author.name, url: blog.abs(blog.author.url) },
    publisher: { '@id': `${blog.SITE}/#org` }, isPartOf: { '@id': `${blog.SITE}/blog#blog` },
    articleSection: post.category.name, keywords: post.tags.join(', '), wordCount: post.words, timeRequired: `PT${post.minutes}M`,
    citation: post.sources.map((s) => ({
      '@type': 'CreativeWork', name: s.title, url: s.url, inLanguage: s.lang,
      ...(s.author ? { author: { '@type': 'Organization', name: s.author } } : {}),
      ...(s.publisher ? { publisher: { '@type': 'Organization', name: s.publisher } } : {}),
      ...(/^\d{4}$/.test(s.year) ? { datePublished: s.year } : {}),
    })),
  },
  orgLd(blog), teamLd(blog), breadcrumbLd(blog, trail),
  ...(post.faq.length ? [{ '@type': 'FAQPage', mainEntity: post.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripHtml(renderInline(f.a)) } })) }] : []),
] };
---
<Base title={post.title.length <= 48 ? `${post.title} | BÖTE Blog` : post.title} description={post.description} path={post.url}
  image={post.image} imageAlt={post.imageAlt} type="article" ld={ld} slug={post.slug} progress current={post.category.slug} mdAlt={`${post.url}.md`}>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate(post.date)}>
    <meta property="article:modified_time" content={isoDate(post.updated)}>
    <meta property="article:section" content={post.category.name}>
  </Fragment>
  <article aria-labelledby="yazi-basligi">
    <div class="post-top"><header class="post-head">
      <Crumbs items={trail} />
      <p class="kicker"><a href={post.category.url}>{post.category.name}</a> · <time datetime={post.date}>{trDate(post.date)}</time>{post.updated !== post.date && <> · güncellendi <time datetime={post.updated}>{trDate(post.updated)}</time></>}</p>
      <h1 id="yazi-basligi" style={`view-transition-name: t-${post.slug}`}>{post.title}</h1>
      <p class="dek">{post.description}</p>
      <div class="byline">
        <span>Yazan <a href={blog.author.url} rel="author">{blog.author.name}</a></span>
        <span>{post.minutes} dk okuma</span>
        <ViewCount client:idle slug={post.slug} count />
        <a class="src-pill" href="#kaynaklar">{post.sources.length} kaynak · <i>{post.foreign} yabancı</i></a>
      </div>
      <div class="strip" aria-label="Kaynak dilleri">
        <span class="strip-label">Kaynaklar</span>
        {post.sources.map((s) => <a class={s.lang === 'tr' ? 'tr' : 'en'} href={`#kaynak-${s.n}`} title={`${s.n}. ${s.title}`}>{s.lang.toUpperCase()}</a>)}
      </div>
    </header></div>
    {post.art && (
      <figure class="post-art">
        <img src={post.art.src} width={post.art.width} height={post.art.height} alt={`Kaynak takımyıldızı: bu yazının ${post.sources.length} kaynağı, ${post.foreign} tanesi yabancı dilde`} fetchpriority="high" decoding="async" style={`view-transition-name: c-${post.slug}`} />
      </figure>
    )}
    <div class="reading">
      <nav class="toc-rail toc" aria-label="İçindekiler">
        <p class="toc-title">İçindekiler</p>
        <ol>{tocItems.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
      </nav>
      <div class="prose">
        {post.draft && <p class="draft-banner">TASLAK · editör onayı bekliyor, yayında değil.</p>}
        {post.summary.length > 0 && (
          <section class="tldr" aria-labelledby="kisaca">
            <h2 id="kisaca">Kısaca</h2>
            <ul>{post.summary.map((s) => <li set:html={renderInline(s)} />)}</ul>
          </section>
        )}
        <details class="toc-inline toc">
          <summary>İçindekiler</summary>
          <ol>{tocItems.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
        </details>
        <Fragment set:html={post.html} />
        {post.faq.length > 0 && (
          <section class="faq" aria-labelledby="sss">
            <h2 id="sss">Sık sorulan sorular</h2>
            {post.faq.map((f) => <><h3>{f.q}</h3><p set:html={renderInline(f.a)} /></>)}
          </section>
        )}
        <section class="bib" id="kaynaklar" aria-labelledby="kaynaklar-baslik">
          <h2 id="kaynaklar-baslik">Kaynaklar</h2>
          <p class="bib-note">{post.sources.length} kaynak, {post.foreign} tanesi yabancı dilde. Metindeki numaralar bu listeye bağlanır.</p>
          <ol>
            {post.sources.map((s) => {
              const l = sourceLine(s);
              return (
                <li id={`kaynak-${s.n}`}>
                  <span class="n">{s.n}</span>
                  <div class="src-body">
                    {l.lead} <cite>{l.title}</cite>.{l.pub}
                    <div class="src-meta">
                      <span class={`lang ${s.lang === 'tr' ? 'tr' : 'en'}`}>{s.lang.toUpperCase()}</span>
                      <a href={s.url} rel="noopener" target="_blank">{s.url.replace(/^https?:\/\//, '').replace(/\/$/, '').slice(0, 60)}{s.url.replace(/^https?:\/\//, '').length > 60 ? '…' : ''}</a>
                      <span>erişim {trDate(s.accessed)}</span>
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
        <aside class="editorial" aria-label="Editör notu">
          Bu yazı <a href={blog.author.url}>{blog.author.name}</a> tarafından hazırlandı; kaynaklar en son {trDate(lastCheck)} tarihinde kontrol edildi.
          Bir hata mı gördünüz? <a href="/contact">İletişim sayfasından</a> bildirin, düzeltmeyi tarihiyle yazıya işleyelim.
        </aside>
        <ShareBar client:visible url={url} title={post.title} />
      </div>
    </div>
  </article>
  {(newer || older) && (
    <nav class="prevnext" aria-label="Diğer yazılar">
      {older ? <a href={older.url}><span>← Önceki yazı</span>{older.title}</a> : <span />}
      {newer && <a class="next" href={newer.url}><span>Sonraki yazı →</span>{newer.title}</a>}
    </nav>
  )}
  <Widgets mode="band" current={post.slug} />
  {related.length > 0 && (
    <section class="wrap related" aria-labelledby="ilgili">
      <h2 id="ilgili">İlgili yazılar</h2>
      <ol class="rows">{related.map((p) => <li><PostCard post={p} /></li>)}</ol>
    </section>
  )}
  <CitationPeek client:idle />
</Base>
