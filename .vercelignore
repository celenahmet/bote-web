# Yayina CIKMAYAN dosyalar. Depoda dururlar, Vercel'e yuklenmezler.
# 20.09: Vercel Hobby "Deployment Storage" 10 GB kotasi asildi (11,03 GB);
# bu siteden her dagitimda ~490 MB yukleniyordu.

# Eski WordPress agaci (213 MB) yerel diskte blog/ altindaysa yine de yuklenmesin.
# Yeni blog da blog/ altinda uretiliyor (tools/build-blog.mjs); sadece WP dosyalari
# disarida kalir.
blog/wp-*
blog/*.php
blog/.htaccess
blog/license.txt
blog/readme.html
blog/error_log
blog/.user.ini
blog/cgi-bin/

# Eski hata sayfalari (15 MB): /error/404 -> /404 yonlendirmesi var,
# 404.html artik kendi kendine yeten tek dosya.
error/

# Orijinal gorsel kopyalari ve ders dosyalari
originals/
bte432.pptx
Ek_odev.docx
word.pdf
.imunify_patch_id

